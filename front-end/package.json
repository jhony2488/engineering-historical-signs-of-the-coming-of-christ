{
  "name": "sinais-historicos-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-ai-worker.mjs && next dev",
    "build": "node scripts/build-ai-worker.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "auth:hash-password": "tsx scripts/hash-password.ts",
    "indexnow:all": "dotenv -e .env.local -- tsx scripts/indexnow-all.ts",
    "ai:download-models": "tsx scripts/download-local-models.ts",
    "ai:gen-icons": "node scripts/gen-pwa-icons.mjs",
    "google-indexing": "dotenv -e .env.local -- tsx scripts/google-indexing.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cap:init": "cap init",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:build:android": "npm run build && cap sync android && cap build android",
    "android:build": "npm run cap:build:android",
    "tauri:dev": "tauri dev",
    "tauri:build": "TAURI_BUILD=true npm run build && tauri build",
    "tauri:init": "node scripts/init-tauri.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@prisma/client": "^6.1.0",
    "@splinetool/react-spline": "^4.1.0",
    "@wescld/dotted-map": "latest",
    "clsx": "^2.1.1",
    "cytoscape": "^3.30.4",
    "isomorphic-dompurify": "^2.30.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-globe.gl": "^2.38.0",
    "recharts": "^2.15.0",
    "three": "^0.185.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "webpack": "5.101.2",
    "dompurify": "^3.4.17",
    "tinypool": "^2.1.2",
    "deepmerge-ts": "^8.0.0",
    "nanoid": "^3.3.18",
    "qs": "^6.15.4",
    "source-map-js": "^1.2.2",
    "uuid": "^11.1.1",
    "pbkdf2": "^3.1.7",
    "image-size": "^2.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@tauri-apps/cli": "^2.0.0",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/nextjs": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.4",
    "eslint-config-prettier": "^10.1.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "prisma": "^6.1.0",
    "sharp": "^0.35.5",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5",
    "webpack": "5.101.2"
  },
  "browserslist": [
    "defaults",
    "not dead",
    "> 0.2%",
    "last 2 versions",
    "not op_mini all"
  ]
}
