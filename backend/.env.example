# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# LLM (Groq primary, OpenRouter fallback, Ollama opcional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_DRY_RUN=false
GROQ_MODEL_EXTRACTION=llama-3.1-8b-instant
GROQ_MODEL_TIMELINE=mistral-nemo
GROQ_MODEL_REASONING=deepseek-r1-distill
GROQ_MODEL_HERMENEUTICS=gemma2-9b-it
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# API
ADMIN_API_KEY=change-me-in-production
API_RATE_LIMIT=30/minute

# Batch
BATCH_CRON_TZ=America/Sao_Paulo
BATCH_HOUR=4
MAX_DOCUMENTS_PER_DAY=50
EMBEDDING_BATCH_SIZE=8
BGE_MODEL_NAME=BAAI/bge-m3

# Thresholds
FALSE_LEADER_INCONGRUENCE_THRESHOLD=0.7
PHASE_CONFIDENCE_MIN=0.55
PHASE_TRANSITION_MARGIN_MAX=0.15
AUTO_APPROVE_CRITERIA=false

# Weights (correlation layer)
WEIGHT_BAYES=0.35
WEIGHT_HMM=0.35
WEIGHT_LLM=0.30

# ACLED (optional — requer key + email registrados em acleddata.com)
ACLED_API_KEY=
ACLED_EMAIL=

# API.Bible (opcional — corpus teológico expandido)
API_BIBLE_KEY=
API_BIBLE_ID=de4e12af7f28f599-02

# Dados micro (opcional)
REDDIT_ENABLED=false
REDDIT_USER_AGENT=SinaisHistoricosBot/1.0
GOOGLE_TRENDS_ENABLED=false

# Joshua Project (análise no motor; sync via BFF Next)
JOSHUA_API_KEY=
# Limite de chunks embutidos por run diário
EMBED_CHUNK_LIMIT=40
OCR_IMAGES_DIR=

# Classificadores locais (motor/ml/) — rodam em CPU, sem chave
# Gate de relevância zero-shot antes da extração (camada 4)
RELEVANCE_GATE_ENABLED=true
EXTRACTION_TOP_K=10
RELEVANCE_MIN_SCORE=0.0
# Shadow mode: classificador local comparado com saída do LLM (audit camada_4_shadow)
EVENT_SHADOW_ENABLED=true
# Cross-encoder: rerank do RAG teológico + match profecia↔evento
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_MULTIPLIER=4
FULFILLMENT_CE_WEIGHT=0.5
# Dedup semântico por embedding na ingestão
SEMANTIC_DEDUP_ENABLED=true
SEMANTIC_DEDUP_THRESHOLD=0.92
# Distilação da camada 4 (EXTRACTION_MODE=llm|classifier_first)
EXTRACTION_MODE=llm
CLASSIFIER_CONFIDENCE_MIN=0.6
DISTILL_MIN_ROWS=300

# Persistência de longo prazo: apenas Postgres (Supabase). Sem S3 / cold files.

# Cold storage local (legado — CLI archive-cold-storage agora é no-op postgres_only)

# Site + e-mail (digest diário ao final do run_daily)
SITE_URL=http://localhost:3000
EMAIL_FROM=avisos@seudominio.com
EMAIL_DRY_RUN=true
# Resend (recomendado) ou SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
